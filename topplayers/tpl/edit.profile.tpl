<div class="fooltext">    



<!-- start main content --> 
<div class="node"> 
	<div class="border-left2"> 
    	<div class="border-right2"> 
        	<div class="border-top2"> 
            	<div class="border-bot2"> 
                	<div class="corner-top-left2"> 
                    	<div class="corner-top-right2"> 
                        	<div class="corner-bot-left2"> 
                            	<div class="corner-bot-right2"> 
                                	<div class="inner"> 
										<div class="taxonomy"></div> 
										
										<div class="content1">
											<form action="/plugin/topplayers/" method="POST" enctype="multipart/form-data">
												<input type="hidden" name="do" value="save" />
												<input type="hidden" name="id" value="{id}" />
												<table width="100%">
													<tr>
														<td width="50%" align="right" style="padding-right:10px;">Ім'я гравця<font color="#ff0000">*</font>:</td>
														<td><input type="text" name="name" value="{name}" /></td>
													</tr>
													<tr>
														<td>Рейтинг:</td>
														<td>{rating}</td>
													</tr>
													<tr>
														<td>Країна:</td>
														<td><input type="text" name="country" value="{country}" /></td>
													</tr>
													<tr>
														<td>Прапор країни:</td>
														<td>{flag}</td>
													</tr>
													<tr>
														<td>Очки<font color="#ff0000">*</font>:</td>
														<td><input type="text" name="scores" value="{scores}" /></td>
													</tr>
													<tr>
														<td>Дата народження:</td>
														<td><input type="text" name="birthdate" value="{birthdate}" /></td>
													</tr>
													<tr>
														<td>Місце народження:</td>
														<td><input type="text" name="birthplace" value="{birthplace}" /></td>
													</tr>
													<tr>
														<td>Фото:</td>
														<td><input type="text" name="photo" value="{photo}" /><input type="button" value="Завантажити" onclick="javascript:ShowOrHide('uploadphoto');" /></td>
													</tr>
													<tr id="uploadphoto" style="display : none;">
														<td>
															<input type="hidden" name="MAX_FILE_SIZE" value="3000000" />
															Файл:</td>
														<td>
															<input type="file" name="photofile" />
														</td>
													</tr>
													<tr>
														<td>Приорітетна рука:</td>
														<td><input type="text" name="hand" value="{hand}" /></td>
													</tr>
													<tr>
														<td valign="top" colspan="2" align="left">Біографія:</td>
													</tr>
													<tr>
													<td colspan="2"><textarea name="biography" rows="40" cols="50">{biography}</textarea></td>
													</tr>
													<tr>
														<td colspan="2" align="center"><input type="submit" class="form-submit" value="Зберегти" /></td>
													</tr>
												</table>
											</form>
										</div> 
										<div class="clear"></div>
									</div> 
                                </div> 
                            </div> 
                        </div> 
                    </div> 
                </div> 
            </div> 
        </div> 
    </div> 
</div>



















