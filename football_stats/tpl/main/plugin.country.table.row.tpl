<tr>
		<td class="cell">{position}</td>
		<td class="cell"><img src='{photo_link}' alt='{name}'  width='15'/> <a href="{link}" style="vertical-align: super;">{name}</a></td>
		<td class="cell" style="text-align: center;">{games-all}</td>
		<td class="cell" style="text-align: center;">{games-wins}</td>
		<td class="cell" style="text-align: center;">{games-draws}</td>
		<td class="cell" style="text-align: center;">{games-defeats}</td>
		<td class="cell" style="text-align: center;">{in}-{out}</td>
		<td class="cell" style="text-align: center;"><strong>{scores}</strong></td>
</tr>