<li class="firstMatchToDisplay">
                    <div class="ticker-item">
                        <div class="ticker-item-status">{status} {date},  {channel}</div>
                        <div class="ticker-item-standing">
                            <div class="home-team">
                                <div class="home-team-name">
                                    <a href="{link-game}">{team-owner}</a>
                                </div>
                                <div class="home-team-score"><a href="{link-game}">{goals-owner}</a></div>
                            </div>
                            <div class="away-team">
                                <div class="away-team-name">
                                    <a href="{link-game}">{team-guest}</a>
                                </div>
                                <div class="away-team-score"><a href="{link-game}">{goals-guest}</a></div>
                            </div>
                        </div>
                    </div>
                </li>