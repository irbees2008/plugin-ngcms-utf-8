<span id="temp.data" style="position: absolute; display: none;"></span><form method="post" action="admin.php?mod=football_stats&amp;action=config-save"><table border="0" width="100%" cellspacing="0" cellpadding="0"><tr><td width="50%" class="contentEntry1">{l_fs:pagination}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="pagination" value="{pagination}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:championats}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="championats" value="{championats}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:photos.url}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="photos_url" value="{photos.url}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:photos.dir}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="photos_dir" value="{photos.dir}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:goals}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="goals" value="{goals}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:uefa_main}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="uefa_main" value="{uefa_main}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:count_card}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="count_card" value="{count_card}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:scorers_in_admin_panel}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="scorers_in_admin_panel" value="{scorers_in_admin_panel}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:scorers_on_site}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="scorers_on_site" value="{scorers_on_site}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:count_scorers_in_main_page}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="count_scorers_in_main_page" value="{count_scorers_in_main_page}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:path_to_upload_photo}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="path_to_upload_photo" value="{path_to_upload_photo}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:day_minus}</td><td width="50%" class="contentEntry2"><input type="text" size="80" name="day_minus" value="{day_minus}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:begin_day_and_hour}</td><td width="50%" class="contentEntry2"><input type="date" name="begin_day" value="{begin_day}" /><input type="time" name="begin_hour" value="{begin_hour}" /></td></tr><tr><tr><td width="50%" class="contentEntry1">{l_fs:end_day_and_hour}</td><td width="50%" class="contentEntry2"><input type="date" name="end_day" value="{end_day}" /><input type="time" name="end_hour" value="{end_hour}" /></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:to_use_caching}</td><td width="50%" class="contentEntry2">    <select name="cache" style="width:415px;" id="cache">
        <option value="1" {selected_yes}>{l_fs:cache_yes}</option>
        <option value="0" {selected_no}>{l_fs:cache_no}</option>
    </select></td></tr><tr><td width="50%" class="contentEntry1">{l_fs:label_cacheExpire}</td><td width="50%" class="contentEntry2">    <input type="text" size="80" name="cacheExpire" id="cacheExpire" value="{cacheExpire}" /></td></tr></table><fieldset><legend><b>Игры тура внутреннего чемпионата</b></legend><table border="0" width="100%" cellspacing="0" cellpadding="0">{rounds}</table></fieldset><select id="leagues-type" style="display: none;">{leagues-type}</select>{league-championats}<fieldset><legend><b>Игры и таблицы ЛЧ, ЛЕ, ЧМ и т.д.</b></legend><table border="0" width="100%" cellspacing="0" cellpadding="0" name="leagues"><tbody id="cfg.body"></tbody></table>&nbsp; <input type="button" value="Добавить новую переменную" onmousedown="addRow()" class="button" /></fieldset><table border="0" width="100%" cellspacing="0" cellpading="0"><tr><td width="100%" colspan="2">&nbsp;</td></tr><tr><td width="100%" colspan="2" class="contentEdit" align="center"><input type="submit" value="{l_fs:button_save}" class="button" /> <input type="button" value="{l_fs:button_clear_cache}" onmousedown="javascript:window.location.href='{admin_url}/admin.php?mod=football_stats&amp;action=clear-cache'" class="button" /><input type="button" value="{l_fs:button.leagues.conf}" onmousedown="javascript:window.location.href='{admin_url}/admin.php?mod=football_stats&amp;action=leagues-conf'" class="button" /></td></tr></table></form><script type="text/javascript">var dData	= {json.data};var dTemplate	= "<tr><td width='90%' class='contentEntry1'><input type='text' size='15' name='league_name[{name}]' value='{name}' />&nbsp;<select name='league_type[{name}]' id='league_type[{name}]' onchange='showChampionatsByType(\"{name}\", this.value)'>{leagues-type}</select><select name='league_championat[{name}]' id='league_championat[{name}]' onchange='setInput(this, \"{name}\")'></select>&nbsp;<select name='league_table[{name}]' id='league_table[{name}]'><option value='0'>игры</option><option value='1'>таблица</option></select></td><td width='10%' class='contentEntry2'><input type='checkbox' name='league_v[{name}]' {checked}>&nbsp;&nbsp;<a href='#' onclick='deleteRow({i})'>удалить</a></td></tr>";// Prepare data rowfunction populateTemplate(row, i) { var tpl = String(dTemplate); var ch  = (row['v']) ? 'checked="checked"' : ''; return tpl.replace(/{id}/g, row['id']).replace(/{type}/g, row['type']).replace(/{v}/g, row['v']).replace(/{name}/g, row['name']).replace(/{checked}/g, ch).replace(/{i}/g, i);}// Load rows from configfunction populateCfg() { var cbody = document.getElementById('cfg.body'); var tmp = ''; var i = 0;  for (dID in dData)  tmp = tmp + populateTemplate(dData[dID], i++); var tStorage = document.getElementById('temp.data'); tStorage.innerHTML = '<table><tbody>'+tmp+'</tbody></table>'; var cParent = cbody.parentNode;  cbody.parentNode.replaceChild(tStorage.firstChild.firstChild, cbody); cParent.tBodies[0].id = 'cfg.body'; for (dID in dData){  setSelect('league_type[' + dData[dID]['name'] + ']', dData[dID]['type']);  showChampionatsByType(dData[dID]['name'], dData[dID]['type']);  setSelect('league_championat[' + dData[dID]['name'] + ']', dData[dID]['id']);  setSelect('league_table[' + dData[dID]['name'] + ']', dData[dID]['t']); }}// Action on "DELETE" button clickfunction deleteRow(id) { if (confirm('Удалить переменную '+id)) {  // Delete with renumbering  var dCounter = document.getElementById('cfg.body').rows.length-1;   for (var i = id; i < dCounter; i++) {   dData[i] = dData[i+1];   dData[i]['id'] = i;  }  delete(dData[dCounter]);  populateCfg(); } return true;}function addRow(){	var name = 'new' + Math.random();	var type = $('#leagues-type :selected').val();	var id   = $('#league-championats-'+type+' :selected').val();		var newEl = {name:name,type:type,id:id,v:0,champt_name:''};	dData.push(newEl);	populateCfg();}function setSelect(id, value){	var i,o,	sel = document.getElementById(id),	opt = sel.options;	for(i=0; i<opt.length; i++){		o = opt[i]; 		if(o.value == value) {			o.selected=true;			break;		}	}sel.style.display = 'none';sel.style.display = '';}	function showChampionatsByType(name, ch){		var el = document.getElementById('league_championat[' + name + ']');		el.options.length = 0;		options = new Array();	$('#league-championats-'+ ch +' option').each(function(){			options.push(new Option(this.text, this.value, false, false));	});		for ( var option in options ){		el.appendChild(options[option]);	}}populateCfg();    $(document).ready(function () {

        if ($('#cache').val() == 0) {
            $('#cacheExpire').attr("disabled", true);
        }
        else { 
            $('#cacheExpire').attr("disabled", false);
        }

        $('#cache').change(function () {
            if ($(this).val() == 0) {
                $('#cacheExpire').attr("disabled", true);
            }
            else { 
                $('#cacheExpire').attr("disabled", false);
            }
        });
    });</script>