<tr align="center" class="contRow1">
<td>{name} {season}</td>
<td><img src="/engine/plugins/football_stats/flags/{alias}.gif"> {country_name}</td>

<td style="width: 15%;">
<input type="image" src="{admin_url}/plugins/football_stats/tpl/images/games.png" title="{l_fs:button_list.games}"  onmousedown="javascript:window.location.href='{admin_url}/admin.php?mod=football_stats&amp;action=games-championat&amp;id={id}'" />&#160;
