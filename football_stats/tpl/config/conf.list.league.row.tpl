<tr align="center" class="contRow1">
<td>{name}</td>

<td style="width: 10%;">
<input type="image" src="{admin_url}/plugins/football_stats/tpl/images/games.png" title="{l_fs:button_list.games}"  onmousedown="javascript:window.location.href='{admin_url}/admin.php?mod=football_stats&amp;action=games-league&amp;id={id}'" />&#160;
<input type="image" src="{admin_url}/plugins/football_stats/tpl/images/edit.png" style="margin: 0 20px;" title="{l_fs:button_edit}"  onmousedown="javascript:window.location.href='{admin_url}/admin.php?mod=football_stats&amp;action=edit-league&amp;id={id}'" />&#160;
<input type="image" src="{admin_url}/plugins/football_stats/tpl/images/dell.png" title="{l_fs:button_dell}"  onmousedown="askDeleteLeague({id}, &#34;{name}&#34;)" />&#160;
</td>
</tr>